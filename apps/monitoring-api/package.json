{
  "name": "@prompt-runner/monitoring-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=iife --global-name=PromptRunnerMonitoringApi --footer:js='module.exports = { handler: PromptRunnerMonitoringApi.handler };' --outfile=dist/index.js --sourcemap=external",
