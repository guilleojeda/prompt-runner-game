{
  "name": "prompt-runner-game",
  "private": true,
  "version": "0.1.0",
  "description": "Juego web educativo para ense\u00f1ar a jugar a un robot virtual.",
  "workspaces": [
    "apps/web",
    "apps/api",
    "apps/runner",
    "infra"
  ],
  "engines": {
    "node": "22.x",
    "npm": ">=10 <12"
  },
  "scripts": {
    "build": "npm run build --workspace @prompt-runner/web && npm run build --workspace @prompt-runner/api && npm run build --workspace @prompt-runner/runner",
    "check": "npm run format && npm run lint && npm run typecheck && npm run build && npm test && npm run synth:infra",
    "dev": "npm run dev --workspace @prompt-runner/web",
    "deploy": "npm run deploy --workspace @prompt-runner/infra",
    "format": "prettier --check package.json package-lock.json tsconfig.json eslint.config.mjs .prettierrc.json 'apps/**/*.{ts,tsx,css,html,json,mjs}' 'infra/**/*.{ts,json}' 'shared/**/*.ts' '.github/workflows/**/*.yml' --ignore-path .gitignore",
    "format:write": "prettier --write package.json package-lock.json tsconfig.json eslint.config.mjs .prettierrc.json 'apps/**/*.{ts,tsx,css,html,json,mjs}' 'infra/**/*.{ts,json}' 'shared/**/*.ts' '.github/workflows/**/*.yml' --ignore-path .gitignore",
    "lint": "eslint apps shared infra eslint.config.mjs",
    "synth": "npm run build && npm run synth:infra",
    "synth:infra": "npm run synth --workspace @prompt-runner/infra",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "aws-cdk": "2.1142.0",
    "aws-cdk-lib": "2.270.0",
    "constructs": "10.8.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
